# Google Drive sync scratch dirs (this folder is Drive-synced)
.tmp.drivedownload/
.tmp.driveupload/

# Stray / temp scripts + scratch
.tmp*
__*.mjs
__*.cjs
# Chrome RESERVES "_"-prefixed names at the extension root — ANY such file makes the whole unpacked
# extension fail to load ("Filenames starting with _ are reserved"). The repo root IS the extension root
# (no build step), so a stray `_tmp_*.mjs` probe at root breaks loading. Root-anchored, so bridge/ etc.
# are unaffected; a legit `_`-file can't exist at root anyway. NB: this keeps scratch OUT OF GIT but an
# untracked `_`-file still breaks the load until deleted — write probes to the TEMP dir, not the repo root.
/_*

# Local env config (FORGE_REPO_PATH etc.) — never commit; example stays tracked
/.env
/.env.*
!/.env.example

# Claude Code local state (memory, session projects) — user-specific
.claude/

# Dependencies (if ever added)
node_modules/

# Dev-bridge host manifest — generated by bridge/install.ps1 with a machine-specific absolute path
bridge/com.orchard.devbridge.json

# DBR-P4-1 (§10/U6) — host-managed git worktree root (per-run branch trees + the preview tree). These are
# separate working copies the host creates/removes; never commit them into the main tree.
/.wt/

# CDK synth output
**/cdk.out/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Dev-bridge local probe / scratch scripts — untracked one-offs, never part of `npm test` (which uses
# bridge/*.test.js). Listed explicitly so no glob can accidentally untrack the tracked host modules
# (bridge/concern.cjs, bridge/host.js, …). Add new probes here, or write them to %TEMP% per CLAUDE.md.
bridge/approvertest.cjs
bridge/debugapprover.cjs
bridge/historytest.cjs
bridge/hooktest.cjs
bridge/hostdrive.cjs
bridge/locktest.cjs
bridge/permtest.cjs
bridge/ppttest.cjs
bridge/reattachdrive.cjs
bridge/relaytest.cjs
bridge/resumetest.cjs

# Leftover commit-message scratch
COMMIT_MSG.tmp

# Fleet self-update (SU / DESIGN_self_update.md) — the updater's untracked on-disk stamps and the dev-machine
# opt-out marker. ready.json/updater-state.json/apply-in-progress are written by the host updater per tick and
# must never be committed (they're per-machine state); .orchard-dev opts a checkout OUT of auto-apply. NB the
# name must NOT start with "_" (Chrome refuses to load "_"-prefixed root files). control.json is NOT ignored —
# it lives tracked on the dedicated `fleet-control` branch, never on main/fleet.
/update/ready.json
/update/updater-state.json
/update/apply-in-progress
/.orchard-dev
