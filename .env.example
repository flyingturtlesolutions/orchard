# Orchard local toolchain config — copy to `.env` (git-ignored) and fill in.
# Names only; no secrets live here. The progress-digest publisher uses your machine's
# existing git auth (credential manager / SSH) — there is NO token to set.

# Local path to the Forge portfolio-catalog repo (working copy) the digest is committed into.
# Required for `node tools/progress-digest/digest.cjs --post`. Unset → publish is skipped (fail-safe).
FORGE_REPO_PATH=

# Optional: override the in-repo digest path (default: project-catalog/digests/webpilot.md).
WEBPILOT_DIGEST_PATH=
